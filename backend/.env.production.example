# Variables para la API en PRODUCCIÓN (se cargan en Railway → Variables, NO en un archivo).
NODE_ENV=production
# PORT lo asigna Railway automáticamente.

# Neon (rama production): pooled para la app, directa para migraciones
DATABASE_URL=postgresql://...-pooler...neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://...neon.tech/neondb?sslmode=verify-full

FRONTEND_URL=https://www.emcacademy.pe
CORS_ORIGINS=https://www.emcacademy.pe,https://emcacademy.pe
COOKIE_DOMAIN=.emcacademy.pe

# NUEVO secreto (no reutilizar el de desarrollo): 64+ caracteres aleatorios
JWT_ACCESS_SECRET=

# Ingreso con Google y Microsoft (retorno: https://api.emcacademy.pe/auth/oidc/{google|microsoft}/callback)
API_PUBLIC_URL=https://api.emcacademy.pe
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
