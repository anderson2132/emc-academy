# Copiar a .env y completar. Nunca subir .env al repositorio.

NODE_ENV=development
PORT=3000

# PostgreSQL local (reemplazar TU_CLAVE por la contraseña del usuario postgres)
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/emc_academy?schema=public

# URL del frontend (CORS y enlaces en correos)
FRONTEND_URL=http://localhost:8080
# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Secreto para firmar los tokens de acceso (mínimo 32 caracteres aleatorios)
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-64-caracteres
# Dominio de las cookies: vacío en local; ".{dominio}" en producción
COOKIE_DOMAIN=

# Ingreso con Google y Microsoft (opcional; sin estas variables los botones se ocultan)
# Retorno a registrar en cada proveedor: {API_PUBLIC_URL}/auth/oidc/google/callback y .../microsoft/callback
API_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Administrador inicial que crea el seed
ADMIN_EMAIL=admin@emcacademy.local
ADMIN_PASSWORD=CambiaEstaClave2026!
ADMIN_NAME=Administrador EMC Academy
